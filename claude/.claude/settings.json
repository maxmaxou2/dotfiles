{
  "cleanupPeriodDays": 99999,
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jaynalerts claude-code-hook on-stop"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "jaynalerts claude-code-hook on-notification"
          }
        ]
      }
    ],
    "SessionStart": [],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/jaynshare title-hook",
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.local/bin/jaynshare status --line",
    "refreshInterval": 15,
    "padding": 1
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "agentmemory@agentmemory": true,
    "frontend-design@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "agentmemory": {
      "source": {
        "source": "github",
        "repo": "rohitg00/agentmemory"
      }
    }
  },
  "effortLevel": "xhigh",
  "autoCompactWindow": 400000,
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "theme": "custom:jaynshare",
  "preferredNotifChannel": "notifications_disabled",
  "agentPushNotifEnabled": true,
  "enableArtifact": false
}
