# Template. `make litellm` renders it to ~/.config/litellm/.env (chmod 600),
# substituting @HOME@ and @USER@. Real values live there and are gitignored.
# The launchd job sources this file before exec'ing the proxy, so every
# `os.environ/X` in config.yaml resolves from here.

# --- Secrets (fill these in) ---
LITELLM_MASTER_KEY=
GITHUB_TOKEN=
OPENCODE_API_KEY=

# --- Vertex AI ---
# GCP project billed for Gemini calls, and the service-account JSON granting
# access to it (place the file yourself, chmod 600 — never committed).
VERTEX_PROJECT=
VERTEX_CREDENTIALS=@HOME@/.config/litellm/vertex-sa.json

# --- Proxy state db ---
DATABASE_URL=postgresql://@USER@@localhost:5432/litellm
