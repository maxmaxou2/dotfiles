# --- Neovim Runtime & State ---
*.swp
*.swo
undo/
*.un~
shada/

# --- Language Servers & Tools ---
lua/mason/
bin/

# --- Log Files ---
*.log

# --- OS Specific ---
.DS_Store

**/automatic_backups/*.json
**/*.bak

# --- Architect planning ephemera ---
opencode/.config/opencode/misc/coding-team/

# --- Editor / tooling state ---
.ropeproject/
# bun/npm link artifacts, recreated by `make jaynalerts`
node_modules/

# --- Secrets (never commit) ---
# NOTE: git has no trailing-comment syntax — "pattern  # why" is one literal
# pattern and silently matches nothing. Keep every comment on its own line.
# config.yaml IS committed: every machine-specific or secret value in it is an
# `os.environ/X` lookup resolved from ~/.config/litellm/.env at proxy startup.
# Only *.env.example templates are committed.
**/.env
# Agent credentials (pi ~/.pi/agent/auth.json, codex ~/.codex/auth.json)
**/auth.json
# pi provider cache, ~110KB of machine-local churn
**/models-store.json
# codex runtime state (sqlite dbs, transcripts, session index)
**/.codex/*.sqlite*
**/.codex/*.jsonl
# GCP service-account keys
**/*-sa.json
**/vertex-sa.json
# Copilot device-flow creds (access-token + api-key.json)
**/github_copilot/

misc/
