# Copied to ~/.config/restic/env (chmod 600) by `make backup` if absent.
# Real values live there only. NEVER commit a filled-in copy: the healthchecks
# URLs are secrets too, since anyone holding one can report a fake success.

# sftp:<ssh Host alias from ~/.ssh/config>:<path relative to the login directory>
export RESTIC_REPOSITORY=sftp:storagebox-backup:restic
export RESTIC_PASSWORD_FILE=$HOME/.config/restic/password

# Fixed name for this Mac's snapshots. The default, the system hostname, changes
# with the network and would break incremental backups and retention.
export RESTIC_HOST=REPLACE_WITH_SHORT_MACHINE_NAME

# healthchecks.io ping URLs. Backup check: period 1 day, grace 2 days.
# Maintenance check: period 7 days, grace 2 days.
export HC_BACKUP_URL=https://hc-ping.com/REPLACE_WITH_BACKUP_CHECK_UUID
export HC_MAINTAIN_URL=https://hc-ping.com/REPLACE_WITH_MAINTENANCE_CHECK_UUID
